# Reference only: export these variables in your shell; no automatic .env loading.
BOOKCLUB_ENV=development
# Optional exact source identity. Unset local checkouts report unversioned.
BOOKCLUB_REVISION=
DEBUG=true
# SECRET_KEY=replace-with-a-generated-private-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_PATH=development.sqlite3
# Default is explicitly UTC; example club-specific configuration:
CLUB_TIMEZONE=Europe/Madrid
# Explicit local command only; no startup or OAuth elevation, no automatic loading.
# INITIAL_ADMIN_DISCORD_ID=100000000000000001
# Migrate an intended disposable database, then: uv run python manage.py bootstrap_admin
# Exact 17–20 ASCII digits; absent/invalid input makes only the command fail.
# Reuses/reapproves the target; another admin (even revoked) blocks owner changes.
# An already configured target rerun leaves every persisted field unchanged.
# Optional real OAuth configuration, provided only by the instance owner.
# No credentials are required for boot/health/session or offline tests.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Exact browser-origin callback; separate temporary proxy example:
DISCORD_REDIRECT_URI=http://localhost:5185/api/auth/discord/callback
