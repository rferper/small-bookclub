{
  "version": 1,
  "modelAllowed": [
    "read-projected-packet",
    "return-schema-diagnosis"
  ],
  "modelDenied": [
    "shell",
    "exec",
    "web",
    "mcp",
    "apps",
    "plugins",
    "subagents",
    "files",
    "production",
    "remediation",
    "messaging"
  ],
  "collectorAllowed": [
    "compose-ps-known-service",
    "inspect-fixed-state-fields",
    "get-prometheus-rules",
    "get-receiver-events"
  ],
  "codeRemediation": {
    "scope": "private local monitoring Compose project only (bookclub-monitor-* or bookclub-observability-*)",
    "allowedActions": [
      "restart-backend"
    ],
    "requires": [
      "alert-rule-firing",
      "validated-model-diagnosis-api-errors-observed-or-service-unhealthy",
      "backend-service-state-known",
      "cooldown-15-minutes-per-project",
      "audit-file-outside-repository"
    ]
  },
  "ownerOnly": [
    "deploy",
    "rollback",
    "restart-of-real-club-or-hosted-services",
    "database-restore",
    "secret-management"
  ],
  "inputMaxBytes": 65536,
  "timeoutMs": 120000,
  "outputMaxBytes": 16384,
  "liveEvidenceRequiresOptIn": true
}
