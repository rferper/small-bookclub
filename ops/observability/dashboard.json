{
  "uid": "bookclub-operations",
  "title": "Club de lectura — Operaciones",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bookclub_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Respuestas por estado y entorno",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code, deployment_environment_name) (bookclub_http_requests_total)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Respuestas 5xx por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bookclub_http_requests_total{http_response_status_code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Registros operativos sin contenido",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"small-bookclub-backend\"}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trazas del backend",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "query": "{ resource.service.name = \"small-bookclub-backend\" }",
          "queryType": "traceqlSearch"
        }
      ]
    }
  ]
}
