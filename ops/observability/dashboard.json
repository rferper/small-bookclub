{
  "uid": "bookclub-operations",
  "title": "Club de lectura — Operaciones",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bookclub_http_requests_total[5m]))",
          "legendFormat": "Solicitudes/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Respuestas por estado y entorno",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code, deployment_environment_name) (bookclub_http_requests_total)",
          "legendFormat": "{{http_response_status_code}} · {{deployment_environment_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Respuestas 5xx por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bookclub_http_requests_total{http_response_status_code=~\"5..\"}[5m])) or (0 * sum(rate(bookclub_http_requests_total[5m])))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 5,
      "title": "Registros operativos sin contenido",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"small-bookclub-backend\"}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trazas del backend",
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Start time": true, "Service": true},
            "indexByName": {"Trace ID": 0, "Name": 1, "Duration": 2},
            "renameByName": {"Trace ID": "Traza", "Name": "Solicitud", "Duration": "Duración"}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Traza"}, "properties": [{"id": "custom.width", "value": 130}]},
          {"matcher": {"id": "byName", "options": "Duración"}, "properties": [{"id": "custom.width", "value": 90}]}
        ]
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "query": "{ resource.service.name = \"small-bookclub-backend\" }",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20
        }
      ]
    }
  ]
}
