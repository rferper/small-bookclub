# Copy outside the checkout to a private file, then replace placeholders.
# Compose --env-file loads this file; Django does not load .env itself.
BOOKCLUB_HOST=club.example.invalid
SECRET_KEY=
BACKUP_DIRECTORY=/srv/bookclub-private/backups
CLUB_TIMEZONE=Europe/Madrid
DEMO_MODE=false
# Set the exact checked-out source revision for a versioned deployment.
BOOKCLUB_REVISION=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Defaults: public interfaces, ports 80/443, public ACME issuer.
# BOOKCLUB_BIND_IP=0.0.0.0
# BOOKCLUB_HTTP_PORT=80
# BOOKCLUB_HTTPS_PORT=443
# TLS_ISSUER=acme
